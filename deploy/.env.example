# Secrets for the local stack (deploy/docker-compose.yml). Copy to deploy/.env and fill in;
# deploy/.env is git- and docker-ignored. Generate random values with e.g. `openssl rand -hex 32`.
# Compose reads this file automatically when started with -f deploy/docker-compose.yml.

# Postgres (the password goes into a URL: avoid @ : / ? # or URL-encode them).
# Changing these after the first start needs `down -v`: the volume keeps the old password.
POSTGRES_USER=rail
POSTGRES_PASSWORD=
POSTGRES_DB=rail

# HMAC key for webhook signatures, shared by the app and the fake gateway
GATEWAY_SECRET=

# HMAC keys for OTP codes and national IDs. Changing NID_KEY orphans existing nid_hash values.
OTP_KEY=
NID_KEY=

# X-Internal-Token for /internal/v1/* on :9091
INTERNAL_TOKEN=

# Cloudflare Turnstile on register and login. Leave both empty to switch it off.
# Cloudflare's always-pass test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Local only: a 6-digit OTP accepted for every booking (no real SMS). Pick your own; leave empty to
# require the real code (the fake SMS gateway prints it: http://localhost:8091/last?phone=...).
# Never set it in production.
OTP_DEV_CODE=
